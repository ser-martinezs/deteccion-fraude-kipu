POSTGRES_PASSWORD=kipu_local
IA_TIMEOUT_MS=6000
POLITICA_RESERVA=reglas
# EP3 · servicio-ia -> SageMaker (sin claves de AWS: las credenciales vienen del perfil de la instancia EC2)
SAGEMAKER_ENDPOINT=kipu-fraude-ep3
AWS_REGION=us-east-1
# Debe ser menor que IA_TIMEOUT_MS del dominio (6 s), que a su vez es menor que el proxy_read_timeout del gateway (8 s)
SAGEMAKER_READ_TIMEOUT_S=5
# EP3 · seguridad y LLM. Los valores reales van SOLO en el .env del servidor (nunca en el repositorio)
API_KEYS=
# Solicitudes por minuto por cliente antes de responder 429 (subirlo para la prueba de Locust y volverlo a su valor)
LIMITE_POR_MINUTO=3000
RABBITMQ_USER=kipu
RABBITMQ_PASSWORD=
NVIDIA_API_KEY=
NVIDIA_MODEL=
# EP3 · despliegue en AWS (compose.aws.yaml). DOMINIO = IP elástica con guiones + .sslip.io
DOMINIO=
# Versión de las imágenes: ep3 (tag de la entrega). Antes del tag, latest (lo que está en main)
TAG=ep3
