POSTGRES_PASSWORD=kipu_local
IA_TIMEOUT_MS=500
POLITICA_RESERVA=reglas
# EP3 · servicio-ia -> SageMaker (sin claves de AWS: las credenciales vienen del perfil de la instancia EC2)
SAGEMAKER_ENDPOINT=kipu-fraude-ep3
AWS_REGION=us-east-1
# Deben ser menores que el read timeout del gateway (2 s) y que IA_TIMEOUT_MS del dominio para que la respuesta llegue
SAGEMAKER_READ_TIMEOUT_S=1.5
